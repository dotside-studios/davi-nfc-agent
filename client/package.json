{
  "name": "@davi/nfc-agent-client",
  "version": "2.0.0",
  "description": "TypeScript client for the Davi NFC Agent",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react/index.ts"
  },
  "main": "dist/nfc-client.js",
  "types": "dist/index.d.ts",
  "files": [
