    "webnfc"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dotside-studios/davi-nfc-agent.git",
    "directory": "client"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
